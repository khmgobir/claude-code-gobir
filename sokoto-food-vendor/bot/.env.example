# Copy this file to ".env" and fill in your key(s).
# Needed only for voice notes + natural-language order understanding.
# The bot still runs without these (customers type item numbers instead).

# OpenAI — Whisper (voice transcription), GPT-4o-mini (understanding), TTS (voice replies)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: only if you set  ai.provider = "deepgram"  in config.json
# DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
